; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Roguelite"
run/main_scene="uid://ctkofwpuvxh40"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="uid://tu08dmbrj42a"

[autoload]

Global="*res://Autoload/Global.gd"
PauseMenu="*res://Autoload/PauseMenu.tscn"
MusicPlayer="*res://Autoload/MusicPlayer.tscn"
SceneChanger="*res://Autoload/SceneChanger.tscn"
MouseCursor="*res://Autoload/MouseCursor.tscn"
ScreenShaker="*res://Autoload/ScreenShaker.gd"
DamageScreen="*res://Autoload/DamageScreen.tscn"
FogScreen="*res://Autoload/FogScreen.tscn"
CRTScreen="*res://Autoload/CRTScreen.tscn"
GlitchScreen="*res://Autoload/GlitchScreen.tscn"
ShockwaveScreen="*res://Autoload/ShockwaveScreen.tscn"
FreezeTimer="*res://Autoload/FreezeTimer.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/AsepriteWizard/plugin.cfg")

